        "mcpDiagram": {
          "tool": "create_mermaid_diagram",
          "mermaid": "flowchart TD\n  T[ticket] --> S{To Do?}\n  S -- no --> N[None: past the frontier]\n  S -- yes --> H{held?}\n  H -- yes --> Ho[Hold]\n  H -- no --> P{unassigned, no order of ours, an open MR on it?}\n  P -- yes --> N2[None: a teammate builds it]\n  P -- no --> B{every blocker Done or Cancelled?}\n  B -- yes --> C[Clean: dispatch off the default branch]\n  B -- no --> K{forge stacks, one open blocker, In QA with an open MR, its own blockers ended?}\n  K -- yes --> Sk[Stacked: dispatch off the parent's branch]\n  K -- no --> Bl[Blocked: wait]\n  class C success\n  class Sk success\n  class Ho muted\n  class Bl warning\n  class N muted\n  class N2 muted",
          "options": {},
          "type": "flowchart",
          "title": "Dispatch classification (a To Do ticket's frontier bucket)",
          "editable": true
        }
      },

        "mcpNodeId": "root_start",
        "mcpDiagram": {
          "tool": "create_mermaid_diagram",
          "mermaid": "stateDiagram-v2\n  state \"pass\" as Pass\n  [*] --> Pass : LaunchCaptain, rested or case raised (fleetd)\n  Pass --> Done : status done (cog)\n  Done --> [*] : StandDownCaptain (fleetd)\n  Pass --> Escalated : status escalated, proposals block close (cog)\n  Escalated --> Done : operator settles proposals (cog)\n  Pass --> [*] : StandDownCaptain, dead, or convoy not active (fleetd)\n  Escalated --> [*] : StandDownCaptain, dead, or convoy not active (fleetd)\n  note right of Pass : never healed. Its stand-down starts the convoy's rest (captain_sleep_secs, 900s)\n  class Done success\n  class Escalated warning",
          "options": {},
          "type": "state",
          "title": "Captain (one per convoy, one pass)",
          "editable": true
        }
      }
    },

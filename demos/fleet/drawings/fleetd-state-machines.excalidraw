      "customData": {
        "mcpDiagramId": "aeKXp6EAdI",
        "mcpDiagram": {
          "tool": "create_mermaid_diagram",
          "mermaid": "stateDiagram-v2\n  [*] --> Draft : fleetc launch --draft (worker, or a hand)\n  [*] --> Open : fleetc launch (hand)\n  Draft --> Open : Handoff un-drafts (fleetd), or weigh in QA\n  Open --> Draft : anchor (ticket or convoy) or rework, disarmed (operator)\n  Open --> Merged : forge merges, armed by the sailor, or merged by hand\n  Draft --> Closed : forge, decommission or recall\n  Open --> Closed : forge, decommission or recall\n  Closed --> Open : reopened on the forge, sync revives it\n  Merged --> [*] : Reap retires it, or sync if no order or cog is left (fleetd)\n  Closed --> [*] : sync retires it, or decommission or recall at once\n  class Merged success\n  class Closed muted\n  class Draft pending",
          "options": {},
          "type": "state",
          "title": "Ship (the ticket's MR)",
          "editable": true
        }
      },
      "text": "Ship (the ticket's MR)",

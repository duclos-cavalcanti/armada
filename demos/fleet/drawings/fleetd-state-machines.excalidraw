      "customData": {
        "mcpDiagramId": "NcaEqouBox",
        "mcpDiagram": {
          "tool": "create_mermaid_diagram",
          "mermaid": "stateDiagram-v2\n  state \"working with the operator\" as Working\n  [*] --> Working : Spawn hand, any status, even held (fleetd)\n  Working --> Concluded : status concluded, /fleet-yield, no open blocker (cog)\n  Concluded --> [*] : Handoff to a sailor, ticket In QA (fleetd)\n  Working --> Done : status done, no MR, no open blocker (cog)\n  Done --> [*] : Reap, ticket Done (fleetd)\n  Working --> Anchored : status anchored (cog)\n  Anchored --> Working : weigh (operator)\n  note left of Working : never escalates. dead - Heal in place. A ticketless fleetc hand is never reconciled\n  class Concluded success\n  class Done success\n  class Anchored muted",
          "options": {},
          "type": "state",
          "title": "Hand (operator-driven)",
          "editable": true
        }
      },
      "text": "Hand (operator-driven)",

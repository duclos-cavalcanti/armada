      "customData": {
        "mcpDiagramId": "9t8hfLkIaZ",
        "mcpDiagram": {
          "tool": "create_mermaid_diagram",
          "mermaid": "stateDiagram-v2\n  state \"tmux session live\" as Live {\n    [*] --> Active : activity under active_secs (120s)\n    Active --> Quiet : silent past active_secs\n    Quiet --> Idle : silent past quiet_secs (1800s)\n    Quiet --> Active : activity\n    Idle --> Active : activity\n  }\n  [*] --> Live : unended session, polled every poll_secs (5s)\n  Live --> Dead : tmux session gone\n  Dead --> Live : Heal relaunches it in place\n  Live --> [*] : session ended\n  Dead --> [*] : session ended\n  note right of Dead : only Dead drives reconcile - Heal, or a stand-down (sailor, captain, lookout, admiral). An anchored cog is left alone\n  class Active success\n  class Quiet pending\n  class Idle muted\n  class Dead warning",
          "options": {},
          "type": "state",
          "title": "Liveness (derived each poll, never stored)",
          "editable": true
        }
      },
      "text": "Liveness (derived each poll, never stored)",

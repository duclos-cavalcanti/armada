      "link": null,
      "locked": false,
      "customData": {
        "mcpDiagramId": "48TAUN2nQZ",
        "mcpNodeId": "Open",
        "mcpDiagram": {
          "tool": "create_mermaid_diagram",
          "mermaid": "stateDiagram-v2\n  state \"open\" as Open\n  state \"refuted\" as Refuted\n  state \"confirmed\" as Confirmed\n  state \"ruled\" as Ruled\n  state \"withdrawn\" as Withdrawn\n  state \"unruled\" as Unruled\n  [*] --> Open : worker or sailor reports escalated, or Capped (fleetd)\n  Open --> Open : re-escalation joins it\n  Open --> Refuted : verdict REFUTE (captain, admiral or operator)\n  Open --> Confirmed : verdict CONFIRM, or Capped (fleetd)\n  Open --> Withdrawn : cog reports anything else, or ends\n  Refuted --> Confirmed : a newer verdict\n  Confirmed --> Refuted : a newer verdict\n  Confirmed --> Confirmed : re-escalation joins it\n  Confirmed --> Ruled : fleetc ruling (operator, or the delegated admiral)\n  Confirmed --> Unruled : cog reports anything else, or ends\n  Refuted --> [*] : cog's next report, or ends\n  Ruled --> [*] : cog's next report, or ends\n  Withdrawn --> [*]\n  Unruled --> [*]\n  note right of Ruled : a fleetc ruling with no case awaiting one is a standalone case, ruled at once. A ruling on a capped case also weighs the ticket, so the count restarts\n  class Ruled success\n  class Refuted success\n  class Confirmed warning\n  class Withdrawn muted\n  class Unruled muted",
          "options": {},
          "type": "state",
          "title": "Escalation case (a worker's or sailor's)",
          "editable": true
        }
      }
    },

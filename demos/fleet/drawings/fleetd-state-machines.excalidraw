      "version": 5,
      "versionNonce": 1078903336,
      "index": "bCr",
      "isDeleted": false,
      "groupIds": [],
      "frameId": null,
      "boundElements": null,
      "updated": 1795216850288,
      "created": 1795203029742,
      "link": null,
      "locked": false,
      "fontSize": 18,
      "baseFontSize": null,
      "fontFamily": 5,
      "text": "held overlays any status, set by anchor, convoy\nanchor, recall, a captain's not-Ready hold or the\nruling cap. Off the frontier, no worker or sailor\n(a hand still spawns, the cap's sailor waits), arm\nrefused, MR disarmed and drafted (the cap leaves\nits MR as it is)",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "Q4SfrHBFL3Fywxt5LEt8H",
      "originalText": "held overlays any status, set by anchor, convoy\nanchor, recall, a captain's not-Ready hold or the\nruling cap. Off the frontier, no worker or sailor\n(a hand still spawns, the cap's sailor waits), arm\nrefused, MR disarmed and drafted (the cap leaves\nits MR as it is)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "ttcYhLlnRf0W7pmtsZCn7",
      "type": "text",
      "x": 232.49500000000003,
      "y": 3844.25,
      "width": 314.36999999999995,
      "height": 67.5,

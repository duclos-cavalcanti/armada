      "link": null,
      "locked": false,
      "text": "ours only once its worker is in\nreview (pipeline green). Never healed.\nA stand-down short of reviewed\nclears the mark, so the head is\nreviewed again",
      "fontSize": 18,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "1E-vcf4u2Bv_r1bvnerVv",
      "originalText": "ours only once its worker is in\nreview (pipeline green). Never healed.\nA stand-down short of reviewed\nclears the mark, so the head is\nreviewed again",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },

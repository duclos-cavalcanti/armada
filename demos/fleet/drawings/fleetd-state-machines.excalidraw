        "mcpDiagram": {
          "tool": "create_mermaid_diagram",
          "mermaid": "stateDiagram-v2\n  state \"seated\" as Seated\n  [*] --> Seated : LaunchAdmiral, open case CONFIRMed (fleetd)\n  Seated --> Escalated : status escalated, ruling to the operator (cog)\n  Seated --> [*] : StandDown, dead, or CONFIRM no longer stands (fleetd)\n  Escalated --> [*] : StandDown, dead, or CONFIRM no longer stands (fleetd)\n  note right of Seated : up to admirals (3) seated. Never healed, never re-convened for the same verdict\n  class Escalated warning",
          "options": {},
          "type": "state",
          "title": "Admiral (convened on a CONFIRM)",
          "editable": true

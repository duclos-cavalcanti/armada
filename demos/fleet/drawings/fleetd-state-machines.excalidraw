        "mcpDiagram": {
          "tool": "create_mermaid_diagram",
          "mermaid": "stateDiagram-v2\n  state \"sweeping\" as Sweeping\n  [*] --> Escalated : Capped at max_rulings, ticket held (fleetd)\n  [*] --> Sweeping : LaunchSailor, MR needs work (fleetd)\n  Sweeping --> Escalated : status escalated (cog)\n  Escalated --> Sweeping : REFUTE or ruling, cog resumes\n  Sweeping --> Sleeping : status sleeping (cog)\n  Sleeping --> [*] : StandDown (fleetd)\n  Sweeping --> [*] : StandDown, dead (fleetd)\n  Sweeping --> Anchored : status anchored (cog)\n  Anchored --> Sweeping : weigh (operator)\n  note left of Escalated : dead - Heal in place. Reap from any state\n  class Sleeping success\n  class Escalated warning\n  class Anchored muted",
          "options": {},
          "type": "state",
          "title": "Sailor",
          "editable": true
        }

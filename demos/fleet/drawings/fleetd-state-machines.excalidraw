        "mcpDiagram": {
          "tool": "create_mermaid_diagram",
          "mermaid": "stateDiagram-v2\n  state \"reviewing\" as Reviewing\n  [*] --> Reviewing : LaunchLookout, health OK, head unreviewed (fleetd)\n  Reviewing --> Reviewed : status reviewed (cog)\n  Reviewed --> [*] : StandDownLookout (fleetd)\n  Reviewing --> Escalated : status escalated (cog)\n  Escalated --> Reviewed : operator unblocks (cog)\n  Reviewing --> [*] : StandDownLookout, dead, or MR merged or closed (fleetd)\n  Escalated --> [*] : StandDownLookout, dead, or MR merged or closed (fleetd)\n  note right of Reviewing : ours only once its worker is in review (pipeline green). Never healed. A stand-down short of reviewed clears the mark, so the head is reviewed again\n  class Reviewed success\n  class Escalated warning",
          "options": {},
          "type": "state",
          "title": "Lookout (one per MR)",
          "editable": true
        }
      }
    },

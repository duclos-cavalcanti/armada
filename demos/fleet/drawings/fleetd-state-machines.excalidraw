    {
      "id": "vVEWIt_hN6lofwW5e-pat",
      "type": "text",
      "x": 866.2569999999998,
      "y": 3106.5,
      "width": 432.92500000000007,
      "height": 135,
      "strokeColor": "#1e1e1e",

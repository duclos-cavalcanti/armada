      "created": 1795203029742,
      "link": null,
      "locked": false,
      "text": "Reap rolls a parent story or epic up\nto Done once all its children end,\nunless it is a standing convoy",
      "fontSize": 18,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "llZZ5FjSMbtzk4MODZfux",
      "originalText": "Reap rolls a parent story or epic up\nto Done once all its children end,\nunless it is a standing convoy",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },

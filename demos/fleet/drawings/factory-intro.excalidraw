      },
      "fontSize": 4.297558575323816,
      "baseFontSize": null,
      "fontFamily": 5,
      "text": "4 · Each ticket's cog\nticket ended, or a hand's done → Reap\nconcluded → Handoff\nsailor sleeping → StandDown\nwaiting, trials or review, its wait over\n→ Wake, TrialsWake, ReviewWake\ndead → Heal (worker, hand, escalated)\nor StandDown",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "8L7KtPqnGJLwf91diXHK6",
      "originalText": "4 · Each ticket's cog\nticket ended, or a hand's done → Reap\nconcluded → Handoff\nsailor sleeping → StandDown\nwaiting, trials or review, its wait over\n→ Wake, TrialsWake, ReviewWake\ndead → Heal (worker, hand, escalated)\nor StandDown",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },

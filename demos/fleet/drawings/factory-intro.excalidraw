      "verticalAlign": "middle",
      "containerId": "FC0Bn0Bs47-xr2WJOvh8A",
      "originalText": "5 · Captains\ndone, dead or convoy gone\n→ StandDownCaptain\nactive convoy, unanchored, none live,\nrested or a case raised\n→ LaunchCaptain",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },

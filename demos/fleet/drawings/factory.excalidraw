    {
      "id": "qN6RUKIbe25Hr7WBOcbTE",
      "type": "text",
      "x": 21584,
      "y": 550,
      "width": 752,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "engine-pane"
      ],
      "frameId": "vCUzY9RfqspZSBfMe2llN",
      "index": "b6p",
      "roundness": null,
      "seed": 664741241,
      "version": 3,
      "versionNonce": 781343679,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795209477379,
      "created": 1795209477379,
      "link": null,
      "locked": false,
      "text": "One thread, one loop. Each pass runs whatever is due, then waits up\nto 0.5 s for a command.\n\n• observe checks which agent sessions are alive. Writes nothing.\n• sync copies Jira tickets and GitLab MRs into the ledger, the\ndatabase.\n• actuate changes the world: at once for a fleetc command, and every\n~60s to close the gap between intent and reality.\n• exit: stop fleetd and the loop ends. Nothing new gets scheduled.",
      "fontSize": 24,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "One thread, one loop. Each pass runs whatever is due, then waits up to 0.5 s for a command.\n\n• observe checks which agent sessions are alive. Writes nothing.\n• sync copies Jira tickets and GitLab MRs into the ledger, the database.\n• actuate changes the world: at once for a fleetc command, and every ~60s to close the gap between intent and reality.\n• exit: stop fleetd and the loop ends. Nothing new gets scheduled.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },

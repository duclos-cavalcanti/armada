      "customData": {
        "slidesOrder": 5,
        "mcpSlideLayout": "diagram",
        "mcpSlideDesign": {
          "style": "clean",
          "accent": "blue",
          "decor": false
        },
        "presenterNotes": "Implementation. Reconcile sees the order and spawns a worker in its worktree (or a hand, when I want to write the code myself). It implements to the acceptance criteria with tests and lint, opens a draft MR, then has a reviewer agent review it in a fresh context. Fixes needed → fix and review again. Clean → concluded: fleetd hands off, ticket goes to In QA. If it crosses its threshold (today: five rounds) → escalate to triage."
      },
      "name": "Implementation"
    },

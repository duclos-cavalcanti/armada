    {
      "id": "hSGca1cJ7vBJnCLzNd28E",
      "type": "frame",
      "x": 13700,
      "y": 80,
      "width": 1920,
      "height": 1080,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",

#!/bin/sh
# git's reference-transaction hook for a fleet project, linked as <checkout>/.git/hooks/reference-transaction
# (./install.sh --hooks). Every worktree of the checkout runs it (they share its .git), so it guards
# the refs they all share:
#   - from outside the project folder (a borrowed GIT_DIR / GIT_WORK_TREE): no ref may move;
#   - from a lookout (FLEET_SHIP in its environment, wherever it runs) or a review worktree
#     (<project>/review/…): only fetches (refs/remotes/*) may move, and HEAD only in a review
#     worktree — never a branch, a tag, the stash, or the checkout's HEAD;
#   - from anywhere else in the project (the checkout, ticket worktrees): everything passes.
# The project folder is the checkout's parent, found from the shared git dir, so one file serves
# every project. Settings writes (git config, git init) run no hook: fleetd's health check watches
# those.

[ "$1" = prepared ] || exit 0

common=$(cd "$(git rev-parse --git-common-dir)" && pwd -P) || exit 0 # <project>/<checkout>/.git
project=$(dirname "$(dirname "$common")")
here=$(pwd -P)

case "$here/" in
"$project/"*) ;;
*)
    echo "fleet: refused a ref change from $here, outside the project $project — never point git at the project's repository (GIT_DIR, GIT_WORK_TREE, --git-dir)" >&2
    exit 1
    ;;
esac

case "$here/" in
"$project/review/"*) review=1 ;;
*) review= ;;
esac
[ -n "$FLEET_SHIP" ] || [ -n "$review" ] || exit 0

while read -r _ _ ref; do
    case "$ref" in
    refs/remotes/*) ;;
    refs/*)
        echo "fleet: refused $ref from $here — a lookout never changes a branch, a tag or the stash" >&2
        exit 1
        ;;
    *)
        if [ -z "$review" ]; then
            echo "fleet: refused $ref from $here — a lookout moves no HEAD but its review worktree's" >&2
            exit 1
        fi
        ;;
    esac
done
